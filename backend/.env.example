# ================================================================
# GharDilaDo Backend - Environment Variables Template
# ================================================================
# 1. Copy this file and rename it to ".env"
# 2. Fill in the values below
# 3. NEVER share or commit your .env file!
# ================================================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas or Local
MONGO_URI=YOUR_MONGODB_CONNECTION_STRING_HERE

# JWT Secret Key (koi bhi lamba random string)
JWT_SECRET=YOUR_SUPER_SECRET_KEY_HERE

# OTP Expiry (minutes)
OTP_EXPIRY_MINUTES=5

# Cloudinary (Image Upload ke liye)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Twilio (OTP SMS ke liye)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER
